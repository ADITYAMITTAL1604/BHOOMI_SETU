# ── Environment & Mode ────────────────────────────────────────────────────────
ENVIRONMENT=development
# Options: "development", "production", "testing"

DATA_SOURCE=synthetic
# Options: "synthetic" (canonical CSVs/GeoJSON in data/synthetic/), "demo" (procedural generator)

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bhoomi:changeme@db:5432/bhoomisetu
# For lightweight local SQLite testing: sqlite:///./bhoomisetu.db

# ── Auth & Security (JWT) ────────────────────────────────────────────────────
JWT_SECRET=supersecretkey_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Storage & ML ─────────────────────────────────────────────────────────────
DOCUMENT_STORAGE_PATH=/app/storage/documents
ML_MODEL_PATH=/app/ml/models

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Frontend (Vite / Nginx) ───────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
